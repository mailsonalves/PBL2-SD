// Memória de Padrões 8x8 (256 padrões x 64 bytes = 16.384 bytes)
module pattern_vram (
    input  wire        clk,
    input  wire        we,
    input  wire [13:0] addr,
    input  wire [7:0]  data_in,
    output reg  [7:0]  data_out
);

    (* ramstyle = "M10K, no_rw_check" *) reg [7:0] ram [0:16383];

    // Opcional: descomente para carregar spritesheet customizado
    // initial begin
    //     $readmemh("sprites_data.hex", ram);
    // end

    always @(posedge clk) begin
        if (we)
            ram[addr] <= data_in;
        data_out <= ram[addr];
    end

endmodule